{
  "name": "batch-and-batter-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --ignore-path ../.prettierignore --write ..",
    "format:check": "prettier --ignore-path ../.prettierignore --check .."
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "3.1137.0",
    "@stripe/react-stripe-js": "7.0.0",
    "@stripe/stripe-js": "10.0.0",
    "next": "15.5.27",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "24.10.1",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.7",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
