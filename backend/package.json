{
  "name": "batch-and-batter-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "npm run build && tsc && node --test dist/test/*.test.js && node --test scripts/artifact.test.mjs",
    "seed:dev": "tsc && node dist/tools/seed-dev.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1137.0",
    "@aws-sdk/client-scheduler": "3.1137.0",
    "@aws-sdk/client-sqs": "3.1137.0",
    "@aws-sdk/lib-dynamodb": "3.1137.0",
    "stripe": "22.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@aws-sdk/credential-providers": "3.1137.0",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
