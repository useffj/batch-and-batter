{
  "name": "batch-and-batter-infra",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "build": "npm --prefix ../backend run build && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/infra/test/*.test.js",
    "synth": "cdk synth --lookups=false",
    "deploy:dev": "node scripts/deploy-dev.cjs"
  },
  "dependencies": {
    "aws-cdk-lib": "2.273.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "aws-cdk": "2.1142.0",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
